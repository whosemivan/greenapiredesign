---
import clsx from 'clsx';
import LogoIcon from '@/assets/logo.svg';
import s from './Logo.module.scss';

type Props = {
	class?: string;
};

const { class: className } = Astro.props;
---

<a class={clsx(s.logo, className)} href="/" aria-label="GREEN-API, на главную">
	<LogoIcon class={s.icon} aria-hidden="true" />
	<span class={s.wordmark}>
		GREEN<span class={s.accent}>API</span>
	</span>
</a>
